# ==========================================================
# JUSTVPN ENVIRONMENT
# ==========================================================

# Telegram
BOT_TOKEN=
ADMIN_ID=

# Backend
BACKEND_API_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
BACKEND_API_URL=http://127.0.0.1:8000/api/v1

# Database
DATABASE_PATH=/opt/vpn-bot/data/vpn.db

# 3x-ui
XUI_API_URL=
XUI_API_TOKEN=

# VPN
VPN_HOST=
VPN_NAME=Helsinki
VPN_COUNTRY=Finland

ENABLE_VLESS=true
VPN_VLESS_INBOUND=1

VPN_WIREGUARD_INBOUND=2
VPN_WG_DNS=1.1.1.1

# Public services
MINIAPP_URL=https://app.justfastvpn.ru
PUBLIC_SUBSCRIPTION_BASE_URL=https://s.justfastvpn.ru

# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=https://app.justfastvpn.ru

# Recovery backup encryption
BACKUP_PASSPHRASE=

DEBUG=false
